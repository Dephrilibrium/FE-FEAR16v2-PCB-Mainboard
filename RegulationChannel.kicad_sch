	(text "Regulation-Channels\ndesigned externally\nas a modular shield"
		(exclude_from_sim no)
		(at 21.463 37.338 0)
		(effects
			(font
				(size 3 3)
				(thickness 0.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8ea90666-ab49-4bac-b66c-8c868363a439")
	)
	(text "N/C got Jumpers to GND connected\nso that there is the possibility\nto disconnect the pins from GND\nand use flying wires to connect\nsomething else (if necessary!)"
		(exclude_from_sim no)
		(at 105.41 34.163 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a6a18499-c94a-43c5-bf52-1d09766f9f98")
	)
	(text "Regularly they should be closed,\nbut it's faster and more easy,\nby closing them by soldering as\nit is when they need to be opened\nby cutting them with a scalpell\nwhen the GND-connection is unwanted!"
		(exclude_from_sim no)
		(at 105.537 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d05150c0-0f12-4f12-8db4-e405eb32e7d4")
	)
